OLLAMA_MODEL=gpt-oss:120b-cloud
# Ollama 模型資料的本機路徑（預設使用 Windows 預設位置）
OLLAMA_DATA_DIR=C:\Users\USER\.ollama

# 安全 token，留空則自動產生
OPENCLAW_GATEWAY_TOKEN=

# Gateway 對外監聽方式：lan（區網）/ loopback（僅本機）
OPENCLAW_GATEWAY_BIND=lan

# Port 設定
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# 時區（IANA 格式）
OPENCLAW_TZ=Asia/Taipei

# 資料路徑（Windows 格式）
OPENCLAW_CONFIG_DIR=C:\Users\USER\.openclaw
OPENCLAW_WORKSPACE_DIR=C:\Users\USER\.openclaw\workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=C:\Users\USER\.openclaw-auth-profile-secrets

# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
